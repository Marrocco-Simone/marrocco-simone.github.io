---
import CVWebsite from "../components/CVWebsite";
import DownloadDocxButton from "../components/DownloadDocxButton";
import Layout from "../layouts/Layout.astro";
import { personalInfo } from "../data/personalInfo";

const navLinks = [
  { href: "#education", label: "Education" },
  { href: "#experience", label: "Work Experience" },
  { href: "#publications", label: "Publications" },
  { href: "#skills", label: "Skills" },
  { href: "#service", label: "Academic Service" },
  { href: "#awards", label: "Awards & Certifications" },
];
---

<Layout>
  <header class="sticky top-0 z-10 border-b border-line bg-white/95 backdrop-blur-md">
    <div class="mx-auto flex max-w-[1120px] items-center gap-4 px-4 py-2.5 md:px-6 md:py-3 lg:gap-7">
      <a href="#" class="mr-auto min-w-0 truncate font-display text-lg font-extrabold tracking-[-0.01em] text-ink">
        {personalInfo.name}
      </a>
      <nav aria-label="Sections" class="hidden gap-[22px] xl:flex">
        {navLinks.map((link) => (
          <a href={link.href} class="whitespace-nowrap font-display text-sm font-medium text-muted hover:text-ink">
            {link.label}
          </a>
        ))}
      </nav>
      <DownloadDocxButton client:idle />
    </div>
  </header>
  <CVWebsite />
</Layout>
