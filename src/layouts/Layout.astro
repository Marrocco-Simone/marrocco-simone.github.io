---
import { personalInfo } from "../data/personalInfo";

const description = `${personalInfo.roles.join(" · ")}. University of Trento, Italy.`;
---

<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <title>{personalInfo.name}</title>
  </head>
  <body class="bg-white font-serif text-[17px] leading-[1.65] text-ink">
    <slot />
  </body>
</html>

<style is:global>
  :focus-visible {
    outline: 2px solid theme("colors.accent.DEFAULT");
    outline-offset: 2px;
  }
  .link {
    color: theme("colors.accent.DEFAULT");
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .link:hover {
    color: theme("colors.accent.hover");
  }
</style>
